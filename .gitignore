# compiled output
/dist
/node_modules
/build

# TS output ne smije završiti u izvornom stablu. Neuspio `tsc -b` (npr. kad
# apps/*/tsconfig.app.json nema `references` na lib koji importuje) emituje .js
# i .d.ts pored .ts izvora umjesto u dist/.
apps/**/src/**/*.js
apps/**/src/**/*.d.ts
apps/**/src/**/*.js.map
libs/**/src/**/*.js
libs/**/src/**/*.d.ts
libs/**/src/**/*.js.map

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
CLAUDE.md
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

