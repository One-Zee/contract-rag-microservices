{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/contract-rag-microservices/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/contract-rag-microservices/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/contract-rag-microservices",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "indexing-service": {
      "type": "application",
      "root": "apps/indexing-service",
      "entryFile": "main",
      "sourceRoot": "apps/indexing-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/indexing-service/tsconfig.app.json"
      }
    },
    "ingestion-service": {
      "type": "application",
      "root": "apps/ingestion-service",
      "entryFile": "main",
      "sourceRoot": "apps/ingestion-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingestion-service/tsconfig.app.json"
      }
    },
    "llm-service": {
      "type": "application",
      "root": "apps/llm-service",
      "entryFile": "main",
      "sourceRoot": "apps/llm-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/llm-service/tsconfig.app.json"
      }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/messaging/tsconfig.lib.json"
      }
    },
    "retrieval-service": {
      "type": "application",
      "root": "apps/retrieval-service",
      "entryFile": "main",
      "sourceRoot": "apps/retrieval-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/retrieval-service/tsconfig.app.json"
      }
    },
    "telemetry": {
      "type": "library",
      "root": "libs/telemetry",
      "entryFile": "index",
      "sourceRoot": "libs/telemetry/src",
      "compilerOptions": {
        "tsConfigPath": "libs/telemetry/tsconfig.lib.json"
      }
    }
  }
}