NODE_ENV=development

# Each service listens on its own port. Every value has a default in
# libs/config/src/schemas/base.schema.ts, so this block may be omitted.
GATEWAY_PORT=3000
AUTH_PORT=3001
# Where the gateway looks for auth-service. Under Docker Compose: AUTH_HOST=auth-service
AUTH_HOST=127.0.0.1
INGESTION_PORT=3002
INDEXING_PORT=3003
RETRIEVAL_PORT=3004
LLM_PORT=3005

DATABASE_URL=postgresql://app:dev@localhost:5432/contracts
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contracts


# The keys MUST be a matching pair. A mismatched pair does not fail at boot —
# login succeeds and every verification after it returns 401.
#
#   JWT_PRIVATE_KEY  → validated only by auth-service; no other service may
#                      have it in its environment
#   JWT_PUBLIC_KEY   → the gateway and every protected service
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# `iss` and `aud` are checked on every verification — without them a token would
# be valid anywhere the same key is used.
JWT_ISSUER=clauseiq-auth
JWT_AUDIENCE=clauseiq-api

# The short access-token lifetime is the price of local verification: revocation
# is not immediate, it lags by at most this long (ADR 004).
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

LLM_PROVIDER=ollama
# Locked to 1024 (voyage-law-2) — matches vector(1024) from migration 0001.
EMBEDDING_DIMENSIONS=1024
