NODE_ENV=development

GATEWAY_PORT=3000
AUTH_PORT=3001
AUTH_HOST=127.0.0.1
INGESTION_HOST=127.0.0.1
INGESTION_PORT=3002
INDEXING_PORT=3003
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=3004
LLM_HOST=127.0.0.1
LLM_PORT=3005
# How services call each other: tcp (Nest's TCP transport, the hosts and ports
# above) or rmq (request/response over RabbitMQ, RABBITMQ_URL)
RPC_TRANSPORT=tcp

DATABASE_URL=postgresql://app:dev@localhost:5432/contracts
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contracts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

UPLOAD_MAX_BYTES=10485760

CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# false = cut without looking at clause headings, the naive baseline of the
# phase-7 comparison. Only ever against an evaluation database of its own.
CHUNK_RESPECT_SECTIONS=true
INGESTION_CONCURRENCY=2

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=clauseiq-auth
JWT_AUDIENCE=clauseiq-api
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# Registration is the one public way to obtain a token. Set to false once the
# accounts you need exist (ADR 022); auth-service reads it at boot.
AUTH_REGISTRATION_ENABLED=true

# `voyage` needs
# VOYAGE_API_KEY (dashboard.voyageai.com); without a key set
# EMBEDDING_PROVIDER=fake for a deterministic, network-free provider — refused
# when NODE_ENV=production. The dimension is sealed into the database by
# migration 0001 (vector(1024)); changing it means a new migration and a reindex.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-law-2
VOYAGE_API_KEY=
# Empty = the real API. The load tests point this (and COHERE_BASE_URL,
# ANTHROPIC_BASE_URL) at a local stub instead (eval/load/stub-apis.ts).
VOYAGE_BASE_URL=
EMBEDDING_DIMENSIONS=1024
# chunks per embedding request (Voyage: at most 1000 texts / 120K tokens)
EMBEDDING_BATCH_SIZE=100

# Hybrid search. Candidates are fetched per branch (vector and full-text),
# fused with RRF, then cut to the returned top-k; the three narrow in that
# order. HNSW_EF_SEARCH is how many index candidates are visited before the
# visibility filter — higher means better recall and slower queries, and it
# must stay the same across any two measurements that get compared.
SEARCH_CANDIDATES=20
SEARCH_FUSED=10
SEARCH_TOP_K=5
RRF_K=60
HNSW_EF_SEARCH=100
# all = the lexical branch needs every word of the question in one chunk, which
# a natural-language question almost never finds; any = any word, ranked by
# frequency.
LEXICAL_MATCH=all

# Reranking is off by default: RRF already gives a usable order, and `cohere`
# costs a request and a key per search. COHERE_API_KEY (dashboard.cohere.com)
# is required only when RERANK_PROVIDER=cohere.
RERANK_PROVIDER=none
RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=
COHERE_BASE_URL=

# Answer generation. `ollama` is the default because it needs no key — it does
# need a local daemon (`ollama serve`) and the model pulled (`ollama pull
# llama3.1:8b`), which fails at the first question rather than at boot.
# `anthropic` needs ANTHROPIC_API_KEY (console.anthropic.com). `fake` is
# deterministic and network-free, for tests; it is refused when
# NODE_ENV=production. Leaving LLM_MODEL empty picks the default for the
# chosen provider: claude-haiku-4-5 / llama3.1:8b / fake-legal-assistant.
LLM_PROVIDER=ollama
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MAX_TOKENS=1024
# Deliberately empty: not every model accepts the parameter, and an empty value
# means the field is omitted from the request. Set it (0 is the usual choice)
# before any measurement whose numbers get compared, and record what you used.
LLM_TEMPERATURE=
# Silence, not total duration — a long answer is not a hung one.
LLM_IDLE_TIMEOUT_MS=60000
# Price per million tokens, used only to fill answers.estimated_cost. The API
# returns token counts, never a price, so this is declared here rather than
# hardcoded. Zero for a local model.
LLM_COST_INPUT_PER_MTOK=0
LLM_COST_OUTPUT_PER_MTOK=0

# How a question becomes a prompt. QUERY_CONTEXT_CHUNKS is what llm-service
# asks retrieval for; retrieval caps it at its own SEARCH_FUSED, and the
# prompt is numbered from what actually comes back. QUERY_MIN_SIMILARITY is
# the floor under which the system abstains instead of answering — it ships at
# 0 (off), because similarity is 0 for a chunk only the lexical branch found
# and because the scale differs between embedding providers. Whatever is set
# here is written onto every queries row, so a comparison can say what was in
# force. The context budget is counted with cl100k_base, which is neither
# Claude's tokenizer nor Llama's — an approximation on purpose.
QUERY_CONTEXT_CHUNKS=5
QUERY_MIN_SIMILARITY=0
QUERY_CONTEXT_MAX_TOKENS=6000
QUERY_HISTORY_PAGE_SIZE=20

# Rate limiting at the gateway (ADR 022), per client address and route: the
# general budget for every route, the strict one on top of it for register,
# login, refresh and POST /query. Turn it off for load tests — k6 on one
# machine is one address, and the measurement would measure the throttler.
THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_STRICT_LIMIT=10
# Reverse proxies in front of the gateway. The budgets count by client
# address, and behind a proxy every request comes from the proxy: 1 behind
# one proxy (production's Caddy), 0 when clients connect directly — any
# higher value lets a client choose its own address.
TRUST_PROXY=0

# Telemetry (ADR 019): opt-in, and read before Nest boots — from the
# environment or from this file. An endpoint turns tracing on; `npm run obs:up`
# starts Jaeger, whose OTLP receiver is http://localhost:4318 (UI on
# http://localhost:16686). Metrics are meant for the containerised stack,
# which turns them on by itself: locally six processes would compete for one
# port. OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG are the SDK's own; any
# two measurements that get compared must run with the same settings.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_PROMETHEUS_PORT=9464

# The containerised stack (npm run stack:up / monolith:up, ADR 020) — read by
# Docker Compose, not by the services. Limits are per container and must stay
# symmetric for a fair comparison: the monolith gets six services' worth.
# Grafana is on http://localhost:3030, user admin.
GRAFANA_ADMIN_PASSWORD=admin
SERVICE_CPUS=0.5
SERVICE_MEMORY=512M
MONOLITH_CPUS=3
MONOLITH_MEMORY=3G
