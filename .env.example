NODE_ENV=development

GATEWAY_PORT=3000
AUTH_PORT=3001
AUTH_HOST=127.0.0.1
INGESTION_HOST=127.0.0.1
INGESTION_PORT=3002
INDEXING_PORT=3003
RETRIEVAL_PORT=3004
LLM_PORT=3005

DATABASE_URL=postgresql://app:dev@localhost:5432/contracts
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contracts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

UPLOAD_MAX_BYTES=10485760

CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
INGESTION_CONCURRENCY=2

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=clauseiq-auth
JWT_AUDIENCE=clauseiq-api
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

LLM_PROVIDER=ollama

# `voyage` needs
# VOYAGE_API_KEY (dashboard.voyageai.com); without a key set
# EMBEDDING_PROVIDER=fake for a deterministic, network-free provider — refused
# when NODE_ENV=production. The dimension is sealed into the database by
# migration 0001 (vector(1024)); changing it means a new migration and a reindex.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-law-2
VOYAGE_API_KEY=
EMBEDDING_DIMENSIONS=1024
# chunks per embedding request (Voyage: at most 1000 texts / 120K tokens)
EMBEDDING_BATCH_SIZE=100
