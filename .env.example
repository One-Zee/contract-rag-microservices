NODE_ENV=development

# Svaki servis sluša na svom portu. Sve vrijednosti imaju default u
# libs/config/src/schemas/base.schema.ts, pa se ovaj blok može i izostaviti.
GATEWAY_PORT=3000
AUTH_PORT=3001
INGESTION_PORT=3002
INDEXING_PORT=3003
RETRIEVAL_PORT=3004
LLM_PORT=3005

DATABASE_URL=postgresql://app:dev@localhost:5432/contracts
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=contracts

# Minimum 32 karaktera — kraći ključ šema odbija i servis se ne diže.
# Generisanje: openssl rand -base64 32
JWT_SECRET=promijeni-me-ovo-je-samo-placeholder-bez-vrijednosti
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

LLM_PROVIDER=ollama
# Zaključano na 1024 (voyage-law-2) — poklapa se s vector(1024) iz migracije 0001.
EMBEDDING_DIMENSIONS=1024
