# The production server's .env: copied to /opt/clauseiq/repo/.env on the
# server, `chmod 600`, filled in there and nowhere else (deploy/README.md).
# docker/docker-compose.prod.yaml reads it twice: as every service's
# environment, and to put the passwords into the database and broker URLs.
# Anything not listed keeps the default the services' schemas give it.
#
# Passwords in hex, so that they need no escaping inside a URL:
#   openssl rand -hex 24
#
# The JWT pair (RS256), each key as one base64 line:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
#   base64 -w0 jwt.key; echo     # → JWT_PRIVATE_KEY
#   base64 -w0 jwt.pub; echo     # → JWT_PUBLIC_KEY
#   shred -u jwt.key jwt.pub

# ── Address ──────────────────────────────────────────────────────────────────
# The server's public IPv4 until there is a domain, with a certificate from
# Caddy's own CA (`internal`). With a domain: the domain, and an e-mail
# address here for Let's Encrypt.
SITE_ADDRESS=
CADDY_TLS=internal

# ── Infrastructure ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
RABBITMQ_USER=clauseiq
RABBITMQ_PASSWORD=
# MinIO's root account, which ingestion-service uses as well.
S3_ACCESS_KEY=clauseiq
S3_SECRET_KEY=
S3_BUCKET=contracts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
GRAFANA_ADMIN_PASSWORD=

# ── Accounts ─────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=clauseiq-auth
JWT_AUDIENCE=clauseiq-api
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# true only while the first accounts are created (deploy/README.md).
AUTH_REGISTRATION_ENABLED=false

# ── Paid APIs ────────────────────────────────────────────────────────────────
# Set a spending limit in each provider's console first: the API is public,
# and every question is a model call.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-law-2
VOYAGE_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# claude-haiku-4-5, USD per million tokens — only fills answers.estimated_cost.
LLM_COST_INPUT_PER_MTOK=1
LLM_COST_OUTPUT_PER_MTOK=5
# A trial Cohere key allows 1,000 calls a month, and the evaluation needs
# them: reranking stays off here until the final evaluation runs are done.
RERANK_PROVIDER=none
COHERE_API_KEY=

# ── Answers ──────────────────────────────────────────────────────────────────
# The calibrated threshold (eval/results/contracts_eval/threshold.md) — the
# value of the final calibration once there is one.
QUERY_MIN_SIMILARITY=0.485
LEXICAL_MATCH=all

# ── Limits ───────────────────────────────────────────────────────────────────
# Per service container; six of them on a 4-vCPU server.
SERVICE_CPUS=0.5
SERVICE_MEMORY=512M
