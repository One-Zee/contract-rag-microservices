[Unit]
Description=ClauseIQ nightly backup

[Timer]
# Server time (UTC on a fresh Hetzner image), before the 04:30 reboot window
# of automatic upgrades. Persistent: a backup missed while the server was off
# runs at the next boot.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
