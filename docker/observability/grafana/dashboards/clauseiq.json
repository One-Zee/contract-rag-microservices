          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, http_route) (rate(http_server_request_duration_bucket{job=~\"api-gateway|monolith\"}[1m])))",
          "legendFormat": "p50 {{http_route}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{job=~\"api-gateway|monolith\"}[1m])))",
          "legendFormat": "p95 {{http_route}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(http_server_request_duration_bucket{job=~\"api-gateway|monolith\"}[1m])))",
          "legendFormat": "p99 {{http_route}}"
        }
      ],
      "description": "For POST /query this is the whole stream, not the time to the first event."
