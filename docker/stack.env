# The containerised topology: what a process inside the stack must
# reach, by service name. Loaded after the repository's .env by
# docker-compose.services.yaml and docker-compose.monolith.yaml alike, so these
# win over .env's localhost values; secrets stay in .env and nowhere else.
#
# Every TCP service binds to its own name and its clients connect to that same
# name, so one set of values serves every container. The monolith ignores the
# *_HOST lines: there is no TCP between its parts.

AUTH_HOST=auth-service
INGESTION_HOST=ingestion-service
RETRIEVAL_HOST=retrieval-service
LLM_HOST=llm-service

# The development credentials of docker-compose.yaml.
DATABASE_URL=postgresql://app:dev@postgres:5432/contracts
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000

# Ollama runs on the host, not in the stack.
OLLAMA_BASE_URL=http://host.docker.internal:11434

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_METRICS_EXPORTER=prometheus
