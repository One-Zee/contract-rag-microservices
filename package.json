{
  "name": "contract-rag-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dep:check": "depcruise apps libs monolith bench --output-type err",
    "dep:graph": "depcruise apps libs monolith bench --output-type dot | dot -T svg > docs/architecture/deps.svg",
    "infra:up": "docker compose -f docker/docker-compose.yaml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yaml down",
    "image:build": "docker build -f docker/Dockerfile -t clauseiq:local .",
    "obs:up": "docker compose --env-file .env -f docker/docker-compose.observability.yaml up -d",
    "obs:down": "docker compose --env-file .env -f docker/docker-compose.observability.yaml down",
    "stack:up": "npm run image:build && docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.observability.yaml -f docker/docker-compose.services.yaml up -d --wait",
    "stack:down": "docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.observability.yaml -f docker/docker-compose.services.yaml down",
    "monolith:up": "npm run image:build && docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.observability.yaml -f docker/docker-compose.monolith.yaml up -d --wait",
    "monolith:down": "docker compose --env-file .env -f docker/docker-compose.yaml -f docker/docker-compose.observability.yaml -f docker/docker-compose.monolith.yaml down",
    "dev": "npm run infra:up && npm run start:all",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:ingestion": "nest start ingestion-service --watch",
    "start:indexing": "nest start indexing-service --watch",
    "start:retrieval": "nest start retrieval-service --watch",
    "start:llm": "nest start llm-service --watch",
    "start:monolith": "nest start monolith --watch",
    "start:all": "concurrently -k -n gateway,auth,ingestion,indexing,retrieval,llm -c blue,green,yellow,magenta,cyan,red \"npm:start:gateway\" \"npm:start:auth\" \"npm:start:ingestion\" \"npm:start:indexing\" \"npm:start:retrieval\" \"npm:start:llm\"",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"monolith/**/*.ts\" \"bench/**/*.ts\" \"test/**/*.ts\" \"eval/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/contract-rag-microservices/main",
    "lint": "oxlint apps libs monolith bench test eval",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "eval:fetch": "node eval/scripts/fetch-cuad.ts",
    "eval:select": "node eval/scripts/select-contracts.ts",
    "eval:draft": "node eval/scripts/draft-questions.ts",
    "eval:db": "node eval/scripts/create-db.ts",
    "eval:corpus": "node eval/scripts/setup-corpus.ts",
    "eval:label": "node eval/scripts/label.ts",
    "eval:retrieval": "node eval/scripts/run-retrieval.ts",
    "eval:compare": "node eval/scripts/compare-experiments.ts",
    "eval:threshold": "node eval/scripts/calibrate-threshold.ts",
    "eval:answers": "node eval/scripts/run-answers.ts",
    "eval:judge": "node eval/scripts/judge.ts",
    "eval:agreement": "node eval/scripts/agreement.ts",
    "eval:parity": "node eval/scripts/parity-auth.ts",
    "eval:nest": "node eval/scripts/nest-metrics.ts",
    "load": "node eval/load/run-load.ts",
    "load:series": "node eval/load/series.ts",
    "load:summary": "node eval/load/summarize.ts",
    "load:calibrate": "node eval/load/calibrate-stub.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-amqplib": "^0.69.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.77.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "gpt-tokenizer": "^4.0.0",
    "import-in-the-middle": "^3.4.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
