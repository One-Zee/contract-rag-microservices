{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/database": [
        "./libs/database/src"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ],
      "@app/messaging": [
        "./libs/messaging/src"
      ],
      "@app/messaging/*": [
        "./libs/messaging/src/*"
      ],
      "@app/telemetry": [
        "./libs/telemetry/src"
      ],
      "@app/telemetry/*": [
        "./libs/telemetry/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/contract-rag-microservices/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/ingestion-service/tsconfig.app.json"
    },
    {
      "path": "./apps/indexing-service/tsconfig.app.json"
    },
    {
      "path": "./apps/retrieval-service/tsconfig.app.json"
    },
    {
      "path": "./apps/llm-service/tsconfig.app.json"
    }
  ]
}