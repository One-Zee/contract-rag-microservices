{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/config": ["./libs/config/src/index.ts"],
      "@app/config/*": ["./libs/config/src/*"],
      "@app/database": ["./libs/database/src/index.ts"],
      "@app/database/*": ["./libs/database/src/*"],
      "@app/embeddings": ["./libs/embeddings/src/index.ts"],
      "@app/embeddings/*": ["./libs/embeddings/src/*"],
      "@app/messaging": ["./libs/messaging/src/index.ts"],
      "@app/messaging/*": ["./libs/messaging/src/*"],
      "@app/rpc": ["./libs/rpc/src/index.ts"],
      "@app/rpc/*": ["./libs/rpc/src/*"],
      "@app/telemetry": ["./libs/telemetry/src/index.ts"],
      "@app/telemetry/*": ["./libs/telemetry/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.scripts.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/ingestion-service/tsconfig.app.json"
    },
    {
      "path": "./apps/indexing-service/tsconfig.app.json"
    },
    {
      "path": "./apps/retrieval-service/tsconfig.app.json"
    },
    {
      "path": "./apps/llm-service/tsconfig.app.json"
    },
    {
      "path": "./monolith/tsconfig.app.json"
    },
    {
      "path": "./bench/express-auth/tsconfig.app.json"
    },
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./libs/config/tsconfig.lib.json"
    },
    {
      "path": "./libs/database/tsconfig.lib.json"
    },
    {
      "path": "./libs/embeddings/tsconfig.lib.json"
    },
    {
      "path": "./libs/messaging/tsconfig.lib.json"
    },
    {
      "path": "./libs/rpc/tsconfig.lib.json"
    },
    {
      "path": "./libs/telemetry/tsconfig.lib.json"
    }
  ]
}
